#!/usr/bin/python3

import json
import sys

import psycopg2
import psycopg2.sql as sql


def provision(users):
    for user in users:
        database = sql.Identifier(user["database"])
        username = sql.Identifier(user["username"])

        connection = psycopg2.connect()
        connection.autocommit = True  # CREATE DATABASE cannot run inside a transaction.
        try:
            with connection.cursor() as cursor:
                cursor.execute(
                    "SELECT rolcanlogin FROM pg_roles WHERE rolname = %s",
                    (username.string,)
                )
                role = cursor.fetchone()
                if role is None:
                    cursor.execute(sql.SQL("CREATE ROLE {} LOGIN").format(username))
                elif not role[0]:
                    cursor.execute(sql.SQL("ALTER ROLE {} LOGIN").format(username))

                cursor.execute(
                    "SELECT pg_get_userbyid(datdba) FROM pg_database WHERE datname = %s",
                    (database.string,),
                )
                owner = cursor.fetchone()
                if owner is None:
                    cursor.execute(sql.SQL("CREATE DATABASE {} OWNER {}").format(database, username))
                elif owner[0] != username.string:
                    cursor.execute(sql.SQL("ALTER DATABASE {} OWNER TO {}").format(database, username))
        finally:
            connection.close()


if __name__ == "__main__":
    try:
        with open(sys.argv[1], "rt", encoding="utf-8") as f:
            config = json.load(f)

        provision(config.get("postgres_users", []))
    except FileNotFoundError:
        print("Configuration not found, skipping provisioning.", file=sys.stderr)
