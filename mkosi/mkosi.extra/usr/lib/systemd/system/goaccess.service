[Unit]
Description=Goaccess - fast web log analyzer and interactive viewer
After=network.target network-online.target goaccess-provision.service
Requires=network-online.target goaccess-provision.service

[Service]
Type=simple
User=goaccess
Group=goaccess
Sockets=goaccess-input.socket
StandardInput=socket
ExecStart=/usr/bin/goaccess - \
    --output /var/lib/goaccess/www/index.html \
    --real-time-html \
    --persist
Restart=on-failure

[Install]
WantedBy=multi-user.target
