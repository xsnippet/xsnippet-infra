[Unit]
Description=Provision PostgreSQL users and databases
Requires=postgresql.service
After=postgresql.service

[Service]
Type=oneshot
User=postgres
Group=postgres
ImportCredential=xsnippet.json
ExecStart=/usr/bin/python3 /usr/libexec/postgres-provision %d/xsnippet.json
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
